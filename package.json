{
  "name": "vault",
  "version": "2.0.0",
  "private": true,
  "description": "A private, encrypted-at-rest photo & video vault.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next dev",
    "build": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next build",
    "start": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vault:init": "node --disable-warning=ExperimentalWarning --import tsx scripts/vault.ts init",
    "vault:passwd": "node --disable-warning=ExperimentalWarning --import tsx scripts/vault.ts passwd",
    "vault:import": "node --disable-warning=ExperimentalWarning --import tsx scripts/vault.ts import",
    "vault:reset-2fa": "node --disable-warning=ExperimentalWarning --import tsx scripts/vault.ts reset-2fa"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "exif-reader": "^2.0.3",
    "fractional-indexing": "^4.0.0",
    "geist": "^1.9.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
