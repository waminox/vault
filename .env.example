# Copy to .env and adjust. Every setting is optional.

# Where the encrypted blobs and the SQLite database live. Back this folder up.
VAULT_DATA_DIR=./data

# Serve under a sub-path, e.g. to keep the old https://example.com/vault URL (build-time).
# VAULT_BASE_PATH=/vault

# Behind nginx/Caddy: trust X-Forwarded-For for rate limiting and session info.
# VAULT_TRUST_PROXY=1

# Cookies are Secure (HTTPS-only) in production. Only for plain-http LAN setups:
# VAULT_COOKIE_SECURE=false

# Sessions end after this much inactivity (server side; the UI also auto-locks).
VAULT_SESSION_IDLE_MINUTES=60
VAULT_SESSION_MAX_HOURS=168

# Uploads
VAULT_MAX_UPLOAD_MB=20480
VAULT_CHUNK_MB=8
VAULT_UPLOAD_TTL_HOURS=48

# Trash is shredded automatically after this many days.
VAULT_TRASH_DAYS=30

# Browser cache lifetime for thumbnails/previews (0 = never stored on the device).
VAULT_THUMB_CACHE_SECONDS=3600

# ffmpeg is auto-detected on PATH. Point elsewhere, or set to "off".
# VAULT_FFMPEG=/usr/bin/ffmpeg
# VAULT_FFPROBE=/usr/bin/ffprobe

# scrypt cost for the passphrase (log2 N). 17 ≈ 128 MiB RAM per attempt.
VAULT_KDF_LOGN=17
